# ==============================================================================
# LeadFlow Backend Environment Variables Example
# ==============================================================================

# Database Connection URL
# PostgreSQL / Cloud Postgres (Neon / Supabase / Render / Aiven):
# DATABASE_URL=postgresql+psycopg://username:password@ep-host.region.aws.neon.tech/leadflow?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadflow

# Application Timezone
APP_TIMEZONE=Asia/Kolkata

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
