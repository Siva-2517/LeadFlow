# ==============================================================================
# LeadFlow Environment Variables Example
# ==============================================================================

# Backend Database Configuration (PostgreSQL / Cloud Postgres such as Supabase / Neon)
# e.g.: postgresql+psycopg://username:password@ep-host.region.aws.neon.tech/leadflow?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadflow

# Application Timezone (Default: Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Backend Port and Host
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API URL (Used by Next.js client to call FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
